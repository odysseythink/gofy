#!/bin/bash
set -e

echo "=== Building frontend ==="
cd ../frontend
pnpm install --frozen-lockfile
pnpm build
echo "=== Copying frontend dist to backend ==="
rm -rf ../backend/main/link/frontend/dist
cp -r dist/ ../backend/main/link/frontend/dist/
cd ../backend

echo "=== Building Go binaries ==="
go build -o ../deploy/link main/link/main.go main/link/frontend.go
go build -o ../deploy/admin main/admin/*.go
go build -o ../deploy/app main/app/*.go
go build -o ../deploy/tools main/tools/*.go
go build -o ../deploy/plugins main/plugins/*.go
go build -o ../deploy/sandbox main/sandbox/*.go
go build -o ../deploy/datasets main/datasets/*.go

echo "=== Build complete ==="
